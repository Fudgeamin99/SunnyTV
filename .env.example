# Copy to .env and edit.

# Folder on this machine holding your videos and advert clips.
MEDIA_PATH=./media

# Folder for settings, YouTube downloads and logs.
DATA_PATH=./data

# Web UI port.
PORT=8000

# The address other devices use to reach this server, e.g. http://192.168.1.50:8000
# Needed so the M3U and guide contain links your TV or Plex can open.
PUBLIC_URL=

TZ=Europe/London

# Encoding (all channels are normalised to these settings).
RESOLUTION=1280x720
VIDEO_BITRATE=3000k
X264_PRESET=veryfast
IDLE_STOP_SECONDS=45
